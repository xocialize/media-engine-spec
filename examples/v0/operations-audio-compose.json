            "accepted_required": true,
            "notice": "Made with MiniMax-Music3 (huggingface.co/MiniMaxAI/MiniMax-Music3), under the MiniMax-Music3 Community License."
          },
          "notes": "Commercial use needs MiniMax's written authorization only above USD 20M aggregate yearly revenue from products that use it (licence §3.2). Anyone offering this engine as a hosted service must keep safeguards against infringing outputs (§4). Covers and supplied lyrics may need the original song's rights; this model's licence doesn't grant them.",
          "supports": {
            "languages": [
              "en",
              "zh"
            ],
            "instrumental": true,
