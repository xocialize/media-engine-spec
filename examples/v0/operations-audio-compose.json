{
  "etag": "\"ops-67d02e1a7e9c\"",
  "operations": [
    {
      "operation": "audio.compose",
      "profile": "audio",
      "profile_version": "0.1",
      "title": "Compose a song",
      "summary": "A song from a description of its style, with lyrics or as an instrumental; or a rework of a recording.",
      "inputs": [
        {
          "name": "caption",
          "kind": "text",
          "required": true
        },
        {
          "name": "lyrics",
          "kind": "text",
          "required": false
        },
        {
          "name": "score",
          "kind": "text",
          "required": false
        },
        {
          "name": "reference",
          "kind": "audio",
          "required": false,
          "max": 1,
          "media_types": [
            "audio/wav",
            "audio/flac",
            "audio/mpeg",
            "audio/mp4"
          ]
        },
        {
          "name": "source",
          "kind": "audio",
          "required": false,
          "max": 1,
          "media_types": [
            "audio/wav",
            "audio/flac",
            "audio/mpeg",
            "audio/mp4"
          ]
        }
      ],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 600,
            "x-mes-ui": {
              "label": "Length (s)",
              "widget": "slider"
            }
          },
          "language": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
            "x-mes-ui": {
              "label": "Sung in"
            }
          },
          "planning": {
            "enum": [
              "full",
              "melody",
              "off"
            ],
            "x-mes-ui": {
              "label": "Plan a score",
              "widget": "picker",
              "advanced": true
            }
          },
          "edit": {
            "type": "object",
            "required": [
              "kind"
            ],
            "additionalProperties": false,
            "x-mes-ui": {
              "label": "Rework"
            },
            "properties": {
              "kind": {
                "enum": [
                  "cover",
                  "repaint",
                  "extend"
                ]
              },
              "strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "before_s": {
                "type": "number",
                "minimum": 0
              },
              "after_s": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "anchors": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "x-mes-ui": {
              "label": "Anchors",
              "advanced": true
            },
            "properties": {
              "bpm": {
                "type": "number",
                "minimum": 20,
                "maximum": 300
              },
              "key": {
                "type": "string",
                "pattern": "^[A-G](#|b)? (major|minor)$"
              },
              "time_signature": {
                "type": "string",
                "pattern": "^[1-9][0-9]?/(1|2|4|8|16)$"
              }
            }
          },
          "timestamps": {
            "type": "boolean",
            "default": false,
            "x-mes-ui": {
              "label": "Time the lyrics",
              "widget": "toggle"
            }
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "x-mes-ui": {
              "label": "Seed",
              "widget": "seed",
              "advanced": true
            }
          },
          "quality": {
            "enum": [
              "draft",
              "standard",
              "best"
            ],
            "default": "standard",
            "x-mes-ui": {
              "label": "Quality",
              "widget": "picker"
            }
          },
          "output": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "media_type": {
                "enum": [
                  "audio/wav",
                  "audio/flac"
                ]
              },
              "sample_rate": {
                "type": "integer",
                "minimum": 8000,
                "maximum": 192000
              },
              "bit_depth": {
                "enum": [
                  16,
                  24
                ]
              },
              "channels": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2
              }
            },
            "x-mes-ui": {
              "label": "Format",
              "advanced": true
            }
          }
        }
      },
      "outputs": [
        {
          "name": "song",
          "kind": "audio",
          "media_types": [
            "audio/wav",
            "audio/flac"
          ],
          "min": 1,
          "max": 1
        },
        {
          "name": "score",
          "kind": "text",
          "media_types": [
            "text/vnd.abc"
          ],
          "min": 0,
          "max": 1
        },
        {
          "name": "timestamps",
          "kind": "data",
          "media_types": [
            "application/json"
          ],
          "min": 0,
          "max": 1
        }
      ],
      "limits": {
        "max_duration_s": 600,
        "min_duration_s": 10,
        "max_repaint_s": 90
      },
      "quality_tiers": [
        "draft",
        "standard",
        "best"
      ],
      "models": [
        {
          "id": "ace-step-1.5",
          "title": "ACE-Step 1.5",
          "default": true,
          "quality_tiers": [
            "draft",
            "standard"
          ],
          "memory_class": "large",
          "speed_class": "fast",
          "license": {
            "spdx": "MIT",
            "commercial_use": true,
            "terms_url": "https://github.com/ace-step/ACE-Step-1.5/blob/main/LICENSE"
          },
          "notes": "Write the caption yourself and set language: the planner's own captions can drift off-topic or into the wrong language. Covers and supplied lyrics may need the original song's rights; this model's licence doesn't grant them.",
          "supports": {
            "languages": [
              "en",
              "zh",
              "ja",
              "ko",
              "es",
              "fr",
              "de",
              "it",
              "pt",
              "ru"
            ],
            "instrumental": true,
            "reference": true,
            "edits": [
              "cover",
              "repaint",
              "extend"
            ],
            "anchors": [
              "bpm",
              "key",
              "time_signature"
            ],
            "timestamps": true,
            "sample_rate": 48000,
            "channels": 2
          },
          "limits": {
            "min_duration_s": 10,
            "max_duration_s": 600,
            "max_repaint_s": 90
          }
        },
        {
          "id": "yue2-3b",
          "title": "YuE2 3B",
          "named_only": true,
          "quality_tiers": [
            "standard",
            "best"
          ],
          "memory_class": "large",
          "speed_class": "slow",
          "license": {
            "spdx": "CC-BY-NC-4.0",
            "commercial_use": false,
            "terms_url": "https://huggingface.co/m-a-p/YuE2-3B/blob/main/LICENSE",
            "accepted_required": true,
            "notice": "YuE2-3B by M-A-P (huggingface.co/m-a-p/YuE2-3B), CC BY-NC 4.0. Non-commercial use only: don't sell, license or monetize songs made with it, or use them in paid or client work."
          },
