          "notes": "The subject to repose."
        }
      ],
      "strength": {
        "min": 0,
        "max": 1.5,
        "default": 1.0
      },
      "license": {
        "spdx": "Apache-2.0",
        "commercial_use": true,
        "terms_url": "https://www.apache.org/licenses/LICENSE-2.0"
      },
      "notes": "Put the skeleton first in images, then the subject."
