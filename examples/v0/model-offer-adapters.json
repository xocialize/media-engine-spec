{
  "id": "klein-4b",
  "title": "FLUX.2 Klein 4B",
  "license": {
    "spdx": "Apache-2.0",
    "commercial_use": true,
    "terms_url": "https://www.apache.org/licenses/LICENSE-2.0"
  },
  "memory_class": "medium",
