    {
      "id": "refcontrol-pose",
      "title": "Pose from a skeleton",
      "kind": "ic",
      "slots": [
        {
          "role": "pose",
          "kind": "image",
          "notes": "An OpenPose skeleton."
        },
        {
          "role": "reference",
