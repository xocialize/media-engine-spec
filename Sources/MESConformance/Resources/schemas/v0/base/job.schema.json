{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MES Base 0.1 — Job snapshot (§7.2, §10)",
  "type": "object",
  "required": ["id", "operation", "state", "created_at", "updated_at", "warnings", "retention"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/Id" },
    "operation": { "$ref": "common.schema.json#/$defs/OperationId" },
    "client_ref": { "type": "string", "maxLength": 128 },
    "state": { "$ref": "common.schema.json#/$defs/State" },
    "outcome": { "$ref": "common.schema.json#/$defs/Outcome" },
    "plan": { "$ref": "#/$defs/Plan" },
    "progress": { "$ref": "common.schema.json#/$defs/Progress" },
    "warnings": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Warning" } },
    "result": { "$ref": "#/$defs/Result" },
    "error": { "$ref": "common.schema.json#/$defs/ErrorObject" },
    "retention": {
      "type": "object",
      "required": ["record_expires_at"],
      "additionalProperties": false,
      "properties": {
        "outputs_expire_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "record_expires_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
  },
  "$defs": {
    "Plan": {
      "type": "object",
      "required": ["model", "effective"],
      "additionalProperties": false,
      "properties": {
        "model": { "$ref": "common.schema.json#/$defs/ModelRef" },
        "effective": { "type": "object" },
        "remote_provider": { "$ref": "common.schema.json#/$defs/RemoteProvider" }
      }
    },
    "Output": {
      "type": "object",
      "required": ["index", "name", "kind", "media_type", "bytes", "sha256", "href"],
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" },
        "kind": { "$ref": "common.schema.json#/$defs/Kind" },
        "media_type": { "$ref": "common.schema.json#/$defs/MediaType" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "common.schema.json#/$defs/Sha256" },
        "href": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "duration_s": { "type": "number", "minimum": 0 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "value": {}
      }
    },
    "Result": {
      "type": "object",
      "required": ["outputs", "effective", "provenance"],
      "additionalProperties": false,
      "properties": {
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Output" } },
        "effective": { "type": "object" },
        "provenance": { "$ref": "#/$defs/Provenance" }
      }
    },
    "Provenance": {
      "type": "object",
      "required": ["engine", "operation", "profile_version", "model", "timings"],
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "object",
          "required": ["id", "name", "implementation", "version"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/Id" },
            "name": { "type": "string" },
            "implementation": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "operation": { "$ref": "common.schema.json#/$defs/OperationId" },
        "profile_version": { "$ref": "common.schema.json#/$defs/Version" },
        "model": { "$ref": "common.schema.json#/$defs/ModelRef" },
        "remote_provider": { "$ref": "common.schema.json#/$defs/RemoteProvider" },
        "seed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "timings": {
          "type": "object",
          "required": ["received_at"],
          "additionalProperties": false,
          "properties": {
            "received_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
            "started_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
            "finished_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
            "queue_ms": { "type": "integer", "minimum": 0 },
            "prepare_ms": { "type": "integer", "minimum": 0 },
            "run_ms": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
