{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MES Base 0.1 — events (§11)",
  "type": "object",
  "required": ["type", "seq", "time", "data"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "enum": ["job.state", "job.plan", "job.progress", "job.preview", "job.warning", "job.output_ready", "job.ended",
               "engine.health", "engine.operations_changed"]
    },
    "job": { "$ref": "common.schema.json#/$defs/Id" },
    "client_ref": { "type": "string", "maxLength": 128 },
    "seq": { "type": "integer", "minimum": 0 },
    "time": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "job.state" } } },
      "then": { "properties": { "data": { "type": "object", "required": ["state"], "properties": {
        "state": { "$ref": "common.schema.json#/$defs/State" }, "outcome": { "$ref": "common.schema.json#/$defs/Outcome" } } } } }
    },
    {
      "if": { "properties": { "type": { "const": "job.progress" } } },
      "then": { "properties": { "data": { "$ref": "common.schema.json#/$defs/Progress" } } }
    },
    {
      "if": { "properties": { "type": { "const": "job.warning" } } },
      "then": { "properties": { "data": { "$ref": "common.schema.json#/$defs/Warning" } } }
    },
    {
      "if": { "properties": { "type": { "const": "job.output_ready" } } },
      "then": { "properties": { "data": { "type": "object", "required": ["outputs"], "properties": {
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "job.schema.json#/$defs/Output" } } } } } }
    },
    {
      "if": { "properties": { "type": { "const": "job.ended" } } },
      "then": { "properties": { "data": { "type": "object", "required": ["outcome"], "properties": {
        "outcome": { "$ref": "common.schema.json#/$defs/Outcome" }, "error": { "$ref": "common.schema.json#/$defs/ErrorObject" } } } } }
    }
  ]
}
