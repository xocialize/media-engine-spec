{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MES Audio 0.1 — parameter vocabulary (spec/profiles/audio.md §2)",
  "description": "Descriptors MUST use these names and shapes for the concepts they cover; a descriptor may narrow a shape (fewer enum values, a smaller range), never widen it. Labels are the profile's one label set (§1.10): engines translate them into each model's own.",
  "$defs": {
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "A BCP 47 tag. Absent: the model detects or infers it, and reports it as effective.language."
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "Repeatability, 0 – 2^32−1 (§1.8). Absent: the engine picks one and reports it."
    },
    "quality": { "enum": ["draft", "standard", "best"], "default": "standard" },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "default": 1,
      "description": "generate: how many sounds; each uses seed + i."
    },
    "voice_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "description": "design_voice: how many auditions; each uses seed + i."
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "The output encoding (§1.2).",
      "properties": {
        "media_type": { "enum": ["audio/wav", "audio/flac", "audio/mpeg", "audio/mp4", "audio/ogg"] },
        "sample_rate": { "type": "integer", "minimum": 8000, "maximum": 192000 },
        "bit_depth": { "enum": [16, 24, 32] },
        "channels": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    },
    "voice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "description": "speak: a preset voice, by id from the named model's list (Base §6.5)."
    },
    "emotion_label": {
      "enum": [
        "neutral",
        "happy",
        "sad",
        "angry",
        "afraid",
        "disgusted",
        "surprised",
        "calm",
        "melancholic",
        "excited",
        "humorous",
        "confused",
        "empathetic",
        "embarrassed",
        "depressed",
        "cold",
        "admiring"
      ]
    },
    "emotion": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "speak: how the line should feel (§2.1). label, description, or both.",
      "properties": {
        "label": { "$ref": "#/$defs/emotion_label" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "style": {
      "enum": [
        "normal",
        "whisper",
        "shout",
        "gentle",
        "serious",
        "warm",
        "narration",
        "conversational",
        "news"
      ],
      "description": "speak: delivery rather than feeling (§2.1)."
    },
    "cue": {
      "enum": [
        "laugh",
        "cough",
        "sigh",
        "breath",
        "gasp",
        "clear_throat",
        "hesitation",
        "sob",
        "sniff",
        "pause"
      ]
    },
    "speed": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 2,
      "default": 1,
      "description": "speak: speaking rate, 1 = the model's natural pace."
    },
    "target_duration_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 600,
      "description": "speak: how long the take should be (dub timing)."
    },
    "edit": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "description": "edit_speech: one edit (§3.3). The fields a kind needs are listed in the profile; others are 400.",
      "properties": {
        "kind": {
          "enum": [
            "emotion",
            "style",
            "add_cue",
            "remove_cue",
            "replace_text",
            "insert_text",
            "remove_text",
            "speed",
            "pitch",
            "volume",
            "timbre",
            "de_accent",
            "denoise",
            "trim_silence"
          ]
        },
        "emotion": { "$ref": "#/$defs/emotion_label" },
        "style": { "$ref": "#/$defs/style" },
        "cue": { "$ref": "#/$defs/cue" },
        "at": { "enum": ["start", "end"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "with": { "type": "string", "maxLength": 2000 },
        "anchor": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "position": { "enum": ["before", "after"] },
        "factor": { "type": "number", "minimum": 0.25, "maximum": 4 },
        "semitones": { "type": "number", "minimum": -12, "maximum": 12 },
        "gain_db": { "type": "number", "minimum": -40, "maximum": 40 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "negative_prompt": {
      "type": "string",
      "maxLength": 4000,
      "description": "generate: what to steer away from."
    },
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 600,
      "description": "generate: the exact length of each sound. compose: the target length of the song. Absent: the model's default (generate) or plan (compose), reported as effective.duration_s."
    },
    "planning": {
      "enum": ["full", "melody", "off"],
      "description": "compose: whether the model writes a score before it sings."
    },
    "compose_edit": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "description": "compose: rework the source input (§3.5).",
      "properties": {
        "kind": { "enum": ["cover", "repaint", "extend"] },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "start_s": { "type": "number", "minimum": 0 },
        "end_s": { "type": "number", "exclusiveMinimum": 0 },
        "before_s": { "type": "number", "minimum": 0 },
        "after_s": { "type": "number", "minimum": 0 }
      }
    },
    "anchors": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "compose: musical anchors the plan should keep.",
      "properties": {
        "bpm": { "type": "number", "minimum": 20, "maximum": 300 },
        "key": { "type": "string", "pattern": "^[A-G](#|b)? (major|minor)$" },
        "time_signature": { "type": "string", "pattern": "^[1-9][0-9]?/(1|2|4|8|16)$" }
      }
    },
    "timestamps": {
      "type": "boolean",
      "default": false,
      "description": "compose: ask for line and word timestamps."
    },
    "prompt_enhance": {
      "enum": ["auto", "on", "off"],
      "default": "auto",
      "description": "design_voice: whether the engine may rewrite the description before the model sees it (as Image §1.9)."
    },
    "section": {
      "enum": ["intro", "verse", "pre-chorus", "chorus", "bridge", "solo", "instrumental", "outro"]
    },
    "edited_transcript": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "description": "edit_speech's transcript output: the words and cues of the edited take, in the profile's cue syntax.",
      "properties": { "text": { "type": "string" } }
    },
    "song_timestamps": {
      "type": "object",
      "required": ["lines"],
      "additionalProperties": false,
      "description": "compose's timestamps output.",
      "properties": {
        "lines": { "type": "array", "items": { "$ref": "#/$defs/timed_text" } },
        "words": { "type": "array", "items": { "$ref": "#/$defs/timed_text" } }
      }
    },
    "timed_text": {
      "type": "object",
      "required": ["text", "start_s", "end_s"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "start_s": { "type": "number", "minimum": 0 },
        "end_s": { "type": "number", "minimum": 0 }
      }
    }
  }
}
