{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MES Mesh 0.1 — what each offer supports, and its limits (spec/profiles/mesh.md §4)",
  "description": "Base §6.4: supports on a model offer, with the keys Base and the Mesh profile define, typed per operation; and the limit fields per operation (§4.2).",
  "$defs": {
    "generate_supports": {
      "type": "object",
      "propertyNames": {
        "pattern": "^([a-z][a-z0-9_]*|x-[a-z0-9]+\\.[a-z0-9_]+)$"
      },
      "description": "supports on a mesh.generate offer (§4.1). Unknown x- keys are allowed; clients ignore keys they don't know.",
      "properties": {
        "stream": {
          "type": "boolean"
        },
        "seed": {
          "type": "boolean"
        },
        "voices": {
          "type": "integer",
          "minimum": 0
        },
        "deterministic": {
          "type": "boolean"
        },
        "background_removal": {
          "type": "boolean"
        },
        "resolutions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "vocabulary.schema.json#/$defs/resolution"
          }
        },
        "textures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "vocabulary.schema.json#/$defs/texture"
          }
        },
        "texture_sizes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "vocabulary.schema.json#/$defs/texture_size"
          }
        },
        "maps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "base_color",
              "metallic_roughness",
              "normal",
              "emissive"
            ]
          }
        }
      },
      "additionalProperties": {
        "description": "an x-<vendor>.<name> key"
      }
    },
    "generate_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_faces": {
          "type": "integer",
          "minimum": 1
        },
        "max_faces": {
          "type": "integer",
          "minimum": 1
        },
        "max_texture_size": {
          "type": "integer",
          "minimum": 1
        },
        "max_width": {
          "type": "integer",
          "minimum": 1
        },
        "max_height": {
          "type": "integer",
          "minimum": 1
        },
        "max_megapixels": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "rig_supports": {
      "type": "object",
      "propertyNames": {
        "pattern": "^([a-z][a-z0-9_]*|x-[a-z0-9]+\\.[a-z0-9_]+)$"
      },
      "description": "supports on a mesh.rig offer (§4.1). Unknown x- keys are allowed; clients ignore keys they don't know.",
      "properties": {
        "stream": {
          "type": "boolean"
        },
        "seed": {
          "type": "boolean"
        },
        "voices": {
          "type": "integer",
          "minimum": 0
        },
        "deterministic": {
          "type": "boolean"
        },
        "skeletons": {
          "type": "array",
          "items": {
            "$ref": "vocabulary.schema.json#/$defs/skeleton"
          }
        },
        "auto_skeleton": {
          "type": "boolean"
        },
        "max_influences": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "additionalProperties": {
        "description": "an x-<vendor>.<name> key"
      }
    },
    "rig_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_input_faces": {
          "type": "integer",
          "minimum": 1
        },
        "max_joints": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
