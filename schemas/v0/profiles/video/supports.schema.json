          "channels"
        ]
      }
    },
    "retake_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_width": {
          "type": "integer",
          "minimum": 1
        },
        "max_height": {
          "type": "integer",
          "minimum": 1
        },
        "max_megapixels": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_frames": {
          "type": "integer",
          "minimum": 1
        },
        "max_source_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_retake_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "Limit fields on a video.retake descriptor or offer (§4.2), Base's included."
    },
    "upscale_supports": {
      "type": "object",
      "propertyNames": {
        "pattern": "^([a-z][a-z0-9_]*|x-[a-z0-9]+\\.[a-z0-9_]+)$"
      },
      "description": "supports on a video.upscale offer (§4.1). Unknown x- keys are allowed; clients ignore keys they don't know.",
      "properties": {
