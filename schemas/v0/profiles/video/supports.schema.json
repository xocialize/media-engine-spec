        },
        "voices": {
          "type": "integer",
          "minimum": 0
        },
        "frame_step": {
          "$ref": "vocabulary.schema.json#/$defs/frame_step"
        },
        "deterministic": {
          "type": "boolean"
        },
        "previews": {
          "type": "boolean"
        },
        "scales": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "vocabulary.schema.json#/$defs/scale"
          }
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "vocabulary.schema.json#/$defs/content"
          }
        }
      },
      "additionalProperties": {
        "description": "an x-<vendor>.<name> key"
      }
    },
    "upscale_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_width": {
          "type": "integer",
          "minimum": 1
        },
        "max_height": {
          "type": "integer",
          "minimum": 1
        },
        "max_megapixels": {
          "type": "number",
