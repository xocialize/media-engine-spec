    "interpolate_supports": {
      "type": "object",
      "propertyNames": {
        "pattern": "^([a-z][a-z0-9_]*|x-[a-z0-9]+\\.[a-z0-9_]+)$"
      },
      "description": "supports on a video.interpolate offer (§4.1). Unknown x- keys are allowed; clients ignore keys they don't know.",
      "properties": {
        "stream": {
          "type": "boolean"
        },
