        },
        "max_fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_factor": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        }
      },
      "description": "Limit fields on a video.interpolate descriptor or offer (§4.2), Base's included."
    }
  }
