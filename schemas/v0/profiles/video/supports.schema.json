      "properties": {
        "stream": {
          "type": "boolean"
        },
        "seed": {
          "type": "boolean"
        },
        "voices": {
          "type": "integer",
          "minimum": 0
        },
        "frame_step": {
          "$ref": "vocabulary.schema.json#/$defs/frame_step"
        },
        "deterministic": {
          "type": "boolean"
        },
        "previews": {
          "type": "boolean"
        },
        "audio": {
          "type": "boolean"
        },
        "sample_rate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "negative_prompt": {
          "type": "boolean"
        },
        "extend_before": {
          "type": "boolean"
        },
        "overlap_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": {
        "description": "an x-<vendor>.<name> key"
      },
      "if": {
        "properties": {
          "audio": {
            "const": true
          }
        },
        "required": [
          "audio"
        ]
      },
      "then": {
        "required": [
          "sample_rate",
          "channels"
        ]
      }
    },
    "extend_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_width": {
          "type": "integer",
          "minimum": 1
        },
        "max_height": {
          "type": "integer",
          "minimum": 1
        },
        "max_megapixels": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_frames": {
          "type": "integer",
          "minimum": 1
        },
        "max_source_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_extend_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "Limit fields on a video.extend descriptor or offer (§4.2), Base's included."
    },
    "retake_supports": {
      "type": "object",
      "propertyNames": {
        "pattern": "^([a-z][a-z0-9_]*|x-[a-z0-9]+\\.[a-z0-9_]+)$"
      },
      "description": "supports on a video.retake offer (§4.1). Unknown x- keys are allowed; clients ignore keys they don't know.",
      "properties": {
        "stream": {
          "type": "boolean"
        },
        "seed": {
          "type": "boolean"
        },
        "voices": {
          "type": "integer",
          "minimum": 0
        },
        "frame_step": {
          "$ref": "vocabulary.schema.json#/$defs/frame_step"
        },
        "deterministic": {
          "type": "boolean"
        },
        "previews": {
          "type": "boolean"
        },
        "audio": {
          "type": "boolean"
        },
        "sample_rate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "negative_prompt": {
          "type": "boolean"
        },
        "retake": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "vocabulary.schema.json#/$defs/retake"
          }
        },
        "overlap_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": {
        "description": "an x-<vendor>.<name> key"
      },
      "if": {
        "properties": {
          "audio": {
            "const": true
          }
        },
        "required": [
          "audio"
        ]
