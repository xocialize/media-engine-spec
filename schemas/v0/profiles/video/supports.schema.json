{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MES Video 0.1 — what each offer supports, and its limits (spec/profiles/video.md §4)",
  "description": "Base §6.4: supports on a model offer, with the keys Base and the Video profile define, typed per operation. An offer with audio states sample_rate and channels.",
  "$defs": {
    "generate_supports": {
      "type": "object",
      "propertyNames": {
        "pattern": "^([a-z][a-z0-9_]*|x-[a-z0-9]+\\.[a-z0-9_]+)$"
      },
      "description": "supports on a video.generate offer (§4.1). Unknown x- keys are allowed; clients ignore keys they don't know.",
      "properties": {
        "stream": {
          "type": "boolean"
        },
        "seed": {
          "type": "boolean"
        },
        "voices": {
          "type": "integer",
          "minimum": 0
        },
        "frame_step": {
          "$ref": "vocabulary.schema.json#/$defs/frame_step"
        },
        "deterministic": {
          "type": "boolean"
        },
        "previews": {
          "type": "boolean"
        },
        "audio": {
          "type": "boolean"
        },
        "sample_rate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "negative_prompt": {
          "type": "boolean"
        },
        "first_frame": {
          "type": "boolean"
        },
        "last_frame": {
          "type": "boolean"
        },
        "keyframes": {
          "type": "boolean"
        },
        "soundtrack": {
          "type": "boolean"
        },
        "references": {
          "type": "boolean"
        },
        "frame_rates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "size_step": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": {
        "description": "an x-<vendor>.<name> key"
      },
      "if": {
        "properties": {
          "audio": {
            "const": true
          }
        },
        "required": [
          "audio"
        ]
      },
      "then": {
        "required": [
          "sample_rate",
          "channels"
        ]
      }
    },
    "generate_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_width": {
          "type": "integer",
          "minimum": 1
        },
        "max_height": {
          "type": "integer",
          "minimum": 1
        },
        "max_megapixels": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_frames": {
          "type": "integer",
          "minimum": 1
        },
        "min_width": {
          "type": "integer",
          "minimum": 1
        },
        "min_height": {
          "type": "integer",
          "minimum": 1
        },
        "min_duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_keyframes": {
          "type": "integer",
          "minimum": 0
        },
        "max_soundtrack_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "Limit fields on a video.generate descriptor or offer (§4.2), Base's included."
    },
    "extend_supports": {
      "type": "object",
      "propertyNames": {
        "pattern": "^([a-z][a-z0-9_]*|x-[a-z0-9]+\\.[a-z0-9_]+)$"
      },
